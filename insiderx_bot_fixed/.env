# Your Telegram numeric user ID(s), comma-separated. Example: 123456789,987654321
ADMIN_USER_IDS=8070703752

# Database and runtime settings (defaults shown)
DATABASE_PATH=bot.db
DATABASE_BACKUP_INTERVAL=3600
REDIS_URL=redis://localhost:6379
USE_REDIS=false
DEBUG_MODE=false

# Performance settings
MAX_WORKERS=50
SIMILARITY_THRESHOLD=5
MESSAGE_QUEUE_SIZE=50000
MAX_RETRIES=5
RETRY_DELAY=0.3
BATCH_SIZE=50
CONNECTION_POOL_SIZE=100
MAX_CONCURRENT_DOWNLOADS=25
CHUNK_PROCESSING_SIZE=10

# Rate limiting
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_WINDOW=60

# Health monitoring
HEALTH_CHECK_INTERVAL=30
MAX_MEMORY_MB=512
MAX_CPU_PERCENT=80.0

# Dashboard and security
DASHBOARD_PORT=5000
DASHBOARD_HOST=0.0.0.0
WEBHOOK_SECRET=

# Filtering and image watermark processing
GLOBAL_BLOCKED_WORDS=
ENABLE_IMAGE_PROCESSING=true
