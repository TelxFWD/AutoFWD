TELEGRAM_API_HASH=b3a10e33ef507e864ed7018df0495ca8
TELEGRAM_PHONE=+917588993347

# Required: add at least one bot token from @BotFather.
# Use TELEGRAM_BOT_TOKEN for one bot, or TELEGRAM_BOT_TOKEN_1 ... _10 for multiple bots.
TELEGRAM_BOT_TOKEN=7763869226:AAHEWmD_xF3weTiIpOMfphg9iFvWALm_FyM
# TELEGRAM_BOT_TOKEN_1=YOUR_FIRST_BOT_TOKEN
# TELEGRAM_BOT_TOKEN_2=YOUR_SECOND_BOT_TOKEN

# Optional but recommended for admin commands; create a separate admin bot token if intended.
